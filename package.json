{
  "name": "browserheap",
  "version": "0.2.1",
  "type": "module",
  "description": "A browser for AI agents where idle tabs sleep: real Chromium, a JavaScript REPL whose pages keep working through sleep and wake, and a CLI for Claude Code and Codex.",
  "keywords": [
    "browser",
    "ai-agent",
    "agents",
    "playwright",
    "chromium",
    "headless",
    "tabs",
    "claude-code",
    "codex",
    "repl",
    "web-automation"
  ],
  "license": "MIT",
  "author": "Abhinav Mishra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbhinavMishra32/browserheap.git"
  },
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "browserheap": "./src/cli/main.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "bin": {
      "browserheap": "./dist/cli/main.js"
    }
  },
  "scripts": {
    "setup": "playwright-core install --only-shell chromium",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "biome check .",
    "bench": "node bench/run.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "node scripts/publish-check.mjs && pnpm build"
  },
  "dependencies": {
    "@ghostery/adblocker": "2.20.1",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "acorn": "8.19.0",
    "diff": "9.0.0",
    "playwright-core": "1.63.0",
    "quickjs-emscripten-core": "0.32.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@earendil-works/pi-ai": "1.0.4",
    "@types/node": "^26.0.0",
    "e2b": "2.55.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
