{
  "name": "agent-tabs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A browser for AI agents where a tab costs memory only while the agent is using it.",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "setup": "playwright-core install --only-shell chromium",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "biome check .",
    "bench": "node bench/run.ts"
  },
  "dependencies": {
    "@ghostery/adblocker": "2.20.1",
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@earendil-works/pi-ai": "1.0.4",
    "@types/node": "^26.0.0",
    "e2b": "2.55.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
