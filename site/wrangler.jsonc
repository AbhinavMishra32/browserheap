// Publishes this folder as browserheap.com on Cloudflare (Workers static assets).
// Deploy from this folder: pnpm dlx wrangler deploy
{
  "name": "browserheap-site",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "." },
  "routes": [
    { "pattern": "browserheap.com", "custom_domain": true },
    { "pattern": "www.browserheap.com", "custom_domain": true }
  ]
}
